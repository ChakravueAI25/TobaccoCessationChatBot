DATABASE_URL=postgresql+psycopg://quit_smoke_app:replace-with-local-password@127.0.0.1:5432/quit_smoke_research
API_HOST=127.0.0.1
API_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
AUTH_ENABLED=true
DEVELOPMENT_API_KEY=replace-with-local-development-key
EXPORT_DIRECTORY=exports
BACKUP_DIRECTORY=backups

# Where llama-server is listening. Empty disables the generate route, which is a supported
# state - the app treats an unavailable model as fallback-only rather than as an outage.
LLAMA_SERVER_URL=
LLAMA_TIMEOUT_SECONDS=120

# ---------------------------------------------------------------------------
# Docker deployment only. See docs/GCP_DEPLOYMENT.md - on the study VM this file is generated
# by deploy/gcp/deploy.sh and never edited by hand.
#
# docker-compose.yml builds DATABASE_URL from these so the password lives in one place.
# ENVIRONMENT must be `production` off a development laptop: verify_deployment_is_safe
# refuses to start with the shipped key or with auth disabled outside development.
# ---------------------------------------------------------------------------
POSTGRES_USER=quit_smoke_app
POSTGRES_PASSWORD=replace-with-a-generated-password
POSTGRES_DB=quit_smoke_research
API_PUBLISH_PORT=8000
